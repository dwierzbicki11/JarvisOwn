# Zachowaj swój prawdziwy ~/jarvis/.env. To jest tylko wzór.

GROQ_API_KEY=
STT_MODEL=whisper-large-v3
CHAT_MODEL=openai/gpt-oss-20b

MIC_TARGET=bluez_input.24:B2:31:81:7B:05
TTS_VOICE=pl_PL-mc_speech-medium
TTS_DATA_DIR=/home/zonderq/jarvis/voices

# Lokalny wake-word.
WAKE_THRESHOLD=0.50
WAKE_VAD_THRESHOLD=0.50
WAKE_DEBUG=0
WAKE_SPEEX=1
WAKE_SCORE_WINDOW=3
WAKE_REQUIRED_HITS=2
WAKE_TICK_SECONDS=1.0

# WebRTC VAD po wybudzeniu.
WEBRTC_VAD_MODE=3
WEBRTC_END_SILENCE=0.75
WEBRTC_WAIT_SECONDS=12
WEBRTC_MAX_SPEECH=45
WEBRTC_MIN_RMS=140
WEBRTC_START_WINDOW=10
WEBRTC_START_REQUIRED=6
WEBRTC_MIN_SPEECH_MS=330
WEBRTC_CALIBRATION_SECONDS=0.30
WEBRTC_NOISE_MULTIPLIER=1.75

# Audio/STT.
AUDIO_CLEANUP=1
JARVIS_SESSION_SECONDS=30
AUTO_SLEEP_MINUTES=0

# Historia konwersacji przekazywana modelowi.
# 24 wiadomości = do 12 ostatnich par pytanie/odpowiedź.
CONVERSATION_HISTORY_MESSAGES=24

# Naturalna komenda w jednym zdaniu:
# "Jarvis, jaka będzie jutro pogoda?"
SINGLE_UTTERANCE_WAKE=1
WAKE_COMMAND_GRACE_SECONDS=1.6

# Maksymalny czas oczekiwania na kolejną komendę w aktywnej sesji.
# Po jednym pustym oknie JARVIS wraca do czuwania.
ACTIVE_LISTEN_TIMEOUT=8

# Barge-in: podczas odpowiedzi możesz powiedzieć "Jarvis",
# a TTS zostanie przerwany i asystent przejdzie do nasłuchu.
# Próg jest celowo wyższy niż zwykły wake-word, żeby ograniczyć
# przypadkowe wybudzenia od TV/YouTube i echa własnego głosu JARVIS-a.
BARGE_IN_ENABLED=1
BARGE_IN_WAKE_THRESHOLD=0.65
BARGE_IN_REQUIRED_HITS=2
BARGE_IN_START_DELAY=0.35

# Opcjonalne rozpoznawanie właściciela głosu.
# Najpierw uruchom: python tools/enroll_speaker.py
# Dopiero po zapisaniu profilu ustaw ENABLED=1.
SPEAKER_VERIFY_ENABLED=0
SPEAKER_VERIFY_THRESHOLD=0.74
SPEAKER_ENROLL_SAMPLES=8
SPEAKER_PROFILE_PATH=/home/zonderq/jarvis/data/speaker_profile.npz

# Proaktywne powiadomienia o uczelni.
# JARVIS sam policzy trasę z GTFS i przypomni o wyjściu z domu.
PROACTIVE_ENABLED=1
PROACTIVE_CHECK_SECONDS=60
PROACTIVE_CLASS_NOTICE_MINUTES=60
PROACTIVE_PREP_NOTICE_MINUTES=30
PROACTIVE_LEAVE_WINDOW_MINUTES=6
PROACTIVE_PLAN_HORIZON_HOURS=6
PROACTIVE_ROUTE_CACHE_SECONDS=300

# Ostrzeżenia o baterii słuchawek.
BATTERY_CHECK_SECONDS=300
PROACTIVE_HEADPHONES_LOW_PERCENT=20
PROACTIVE_HEADPHONES_CRITICAL_PERCENT=10

# Pogoda.
WEATHER_CITY=Kraków
WEATHER_LAT=50.0647
WEATHER_LON=19.9450

# Kalendarz - sekretnego URL nie publikuj.
PK_CALENDAR_ICS_URL=

# Transport.
JARVIS_HOME_STOP=Garlica Duchowna Kapliczka
JARVIS_PK_STOP=AKF / PK
JARVIS_HOME_WALK_MINUTES=5
JARVIS_PK_WALK_MINUTES=8
JARVIS_CLASS_BUFFER_MINUTES=10
JARVIS_TRANSFER_MINUTES=3
BT_AUDIO_NAME=Redmi Buds 6 Active
BT_DEVICE_MAC=24:B2:31:81:7B:05
BT_FORCE_MSBC=1
BT_SETTLE_SECONDS=0.35
VOICE_INTENT_THRESHOLD=0.72
